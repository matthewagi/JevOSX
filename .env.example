# Copy to .env (never commit it). Real environment variables take precedence over this file.

# Required: TypeSafe API key for Jev (https://typesafe.ai)
TYPESAFE_API_KEY=

# Optional: pin a Jev version instead of jev-latest
# JEV_MODEL=jev-latest

# Optional: where trajectory memory lives (default ~/.jevosx/memory.db)
# JEVOSX_MEMORY_PATH=~/.jevosx/memory.db

# Optional: OpenAI-compatible model that writes TYPE_TEXT values when no quoted/prepared text fits.
# Leave TEXT_MODEL empty to keep it off (Jev itself never generates text).
# TEXT_MODEL=
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL_API_KEY=
